    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.9.0",
    "eslint-config-next": "^14.2.35",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2",
    "vitest": "^0.34.0"
