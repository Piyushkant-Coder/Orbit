{
  "name": "collaborative-workspace-backend",
  "version": "1.0.0",
  "description": "Real-time collaborative workspace with RBAC",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "test": "cross-env NODE_ENV=test DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workspace_dev?schema=integration_test prisma migrate deploy && cross-env NODE_ENV=test DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workspace_dev?schema=integration_test jest --forceExit --detectOpenHandles",
    "test:unit": "cross-env NODE_ENV=test jest src/authz src/utils --forceExit --detectOpenHandles",
    "test:integration": "cross-env NODE_ENV=test DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workspace_dev?schema=integration_test prisma migrate deploy && cross-env NODE_ENV=test DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workspace_dev?schema=integration_test jest src/integration.test.ts src/cache/dashboard.integration.test.ts --runInBand --forceExit --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node dist/scripts/seed.js",
    "db:reset": "prisma migrate reset --force",
    "worker": "tsx src/worker.ts",
    "worker:watch": "tsx watch src/worker.ts"
  },
  "keywords": [
    "typescript",
    "express",
    "postgres",
    "prisma",
    "websocket",
    "rbac"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@socket.io/redis-adapter": "^8.1.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.13",
    "prisma": "^5.7.0",
    "redis": "^5.12.1",
    "socket.io": "^4.7.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.0.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
