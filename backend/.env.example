# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workspace_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets (32+ random bytes, base64 encoded)
ACCESS_TOKEN_SECRET="your-secret-key-here-min-32-bytes"
REFRESH_TOKEN_SECRET="your-refresh-secret-key-here-min-32-bytes"

# Token TTL
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_GRACE_PERIOD_SECONDS=300

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# Frontend
FRONTEND_ORIGIN="http://localhost:3000"

# Email (for invitations job)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@workspace.example.com"

# Sentry (optional, for error tracking)
SENTRY_DSN=""

# Rate limiting (per user per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
